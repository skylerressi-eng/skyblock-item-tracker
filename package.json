{
  "name": "skyblock-item-tracker",
  "version": "0.1.0",
  "description": "Hypixel SkyBlock rare + exotic item tracker: scans profiles and the Auction House, classifies exotic armor colors and rare items, and stores findings in a searchable database.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test",
    "seed": "node --env-file-if-exists=.env scripts/seed-sample.js",
    "diagnose": "node --env-file-if-exists=.env scripts/diagnose.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "express": "^4.21.2",
    "prismarine-nbt": "^2.5.0"
  },
  "license": "MIT"
}
