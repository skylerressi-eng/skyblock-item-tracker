# Copy to .env and adjust. All values are optional; sensible defaults apply.
#   cp .env.example .env

# HTTP port
PORT=3000

# Where the SQLite database lives
# DB_PATH=./data/tracker.db

# Hypixel API key(s). With a key, player scans read FULL inventories via
# /v2/skyblock/profiles AND the crawler can chain friends-of-friends. Without
# it, scans use the public SkyCrypt API (fewer items) and discover accounts from
# Auction House sellers instead. Get keys at https://developer.hypixel.net
#
# Provide ONE key:
# HYPIXEL_API_KEY=your-key
# ...or MULTIPLE (comma-separated) for more throughput. Each key has its own
# rate-limit budget, so the crawler rotates them. Defaults are intentionally
# GENTLE to avoid burning out / getting the key throttled: 1 lane per key and
# ~120 requests/min per key (well under Hypixel's ~300 ceiling). Raise these
# only if your key is comfortably under its limit.
# HYPIXEL_API_KEYS=key-one,key-two
# CRAWL_CONCURRENCY=3          # parallel account scans (default: 1 per key)
# HYPIXEL_RATE_PER_MIN=120     # per-key request pace (max ~300)
# CRAWL_BATCH=12               # accounts claimed per tick
# AUTH_FAIL_PAUSE=8            # pause after this many key/403 failures
# AUTH_PAUSE_MS=120000         # how long to pause when the key keeps failing
#
# Daily budget guard — Hypixel's key request cap is DAILY and shared across all
# keys on your account. This persists usage across restarts and spreads it evenly
# over the UTC day so you never blow the whole budget at once.
# BUDGET_GUARD=true            # set false to disable the guard
# DAILY_REQUEST_LIMIT=250      # keep a bit under the real ~300/day ceiling
# BUDGET_HEADSTART=0.05        # fraction of budget available immediately each day
# BUDGET_FRIENDS_MIN=20        # skip the (cost-doubling) friends call below this

# Rarity tiers to auto-flag into the "special rarity" category (comma separated).
# Default is the two genuinely-rare event/legacy tiers. Exotic-colour and curated
# game-breaker detection run regardless of this.
# RARE_TIERS=SPECIAL,VERY_SPECIAL

# How many copies of a piece must be seen before its modal colour is trusted
# as the "default" (until then, off-colour pieces are flagged low-confidence).
# PIECE_COLOR_MIN_SAMPLES=4

# Random-dyed cosmetic sets (Satin/Oxford/Velvet/Cashmere — see
# src/data/random-dyed.json) get a random colour from the game, so they are
# never real exotics. Default true: don't store them, and purge any existing
# ones on startup. Set false to keep them (filed under 'random_dyed' instead).
# DROP_RANDOM_DYED=true

# AH price floor (coins) for UNCONFIRMED exotics. An off-default colour with no
# exact-family/learned-default match, listed below this, is treated as a
# baseline/tier-colour false positive (real exotics aren't 37 coins). 0 = off.
# MIN_EXOTIC_PRICE=100000

# How many copies of a piece must share a colour before it's trusted as that
# piece's natural baseline (suppresses flagging the natural colour as exotic).
# PIECE_COLOR_MIN_SAMPLES=4

# ---- Background Auction House discovery worker (ON by default) ----
# Continuously scans the live AH, decodes item NBT, classifies exotics/rares,
# stores sellers + items, and feeds every seller into the crawl queue.
# AH_WORKER=true
# AH_INTERVAL_MS=60000
# AH_MAX_PAGES=5

# ---- Account crawler (ON by default) ----
# Drains a queue of accounts (seeds -> friends [needs key] -> AH sellers),
# scanning each profile and classifying items. This is the "scan everyone" engine.
# CRAWLER=true
# CRAWL_INTERVAL_MS=8000      # how often a batch is processed
# CRAWL_BATCH=3               # accounts scanned per batch
# RESCAN_AFTER_MS=21600000    # don't re-scan an account more often than this (6h)
# MAX_FRIENDS=30              # max friends to enqueue per scanned account (key only)
# MAX_QUEUE_BACKLOG=5000      # stop auto-enqueuing AH sellers past this backlog
# SEED_ON_START=true          # load src/data/seeds.json into the queue on boot
# DORMANT_DAYS=365            # accounts inactive this long are "dormant" (old exotics);
#                             # their friend circles get crawl priority

# Misc
# REQUEST_TIMEOUT_MS=15000
# PRICE_TTL_MS=300000
