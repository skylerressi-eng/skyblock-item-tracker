# Copy to .env and adjust. All values are optional; sensible defaults apply.

# HTTP port
PORT=3000

# Where the SQLite database lives
# DB_PATH=./data/tracker.db

# Hypixel API key. STRONGLY recommended: with a key, player scans read full
# inventories via /v2/skyblock/profiles. Without it, scans fall back to the
# public SkyCrypt API and find fewer items. Get one at https://developer.hypixel.net
# HYPIXEL_API_KEY=

# Rarity tiers to always flag (comma separated). LEGENDARY is intentionally
# omitted because it is extremely common.
# RARE_TIERS=MYTHIC,DIVINE,SPECIAL,VERY_SPECIAL

# How many copies of a piece must be seen before its modal colour is trusted
# as the "default" (until then, off-colour pieces are flagged low-confidence).
# PIECE_COLOR_MIN_SAMPLES=4

# ---- Background Auction House discovery worker ----
# Turn on to continuously scan the live AH, decode item NBT, classify exotics/
# rares, and store sellers + items automatically.
# AH_WORKER=true
# AH_INTERVAL_MS=60000
# AH_MAX_PAGES=5

# Misc
# REQUEST_TIMEOUT_MS=15000
# PRICE_TTL_MS=300000
